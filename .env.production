# Baked into client + SSR at `npm run build` (Vite mode=production).
# Overrides matching keys from `.env` when both exist.
# Hostinger can still override these with panel env vars before build.
VITE_PUBLIC_SITE_URL=https://itq.gamesspoteg.com
VITE_API_BASE_URL=https://api.gamesspoteg.com/api
VITE_API_PROXY_TARGET=https://api.gamesspoteg.com
VITE_SSR_API_BASE_URL=https://api.gamesspoteg.com/api
VITE_LARAVEL_SANCTUM=true
VITE_AUTH_PROVIDER=laravel
VITE_API_TIMEOUT=8000
VITE_PUBLIC_LOGIN=/admin/login
VITE_DISABLE_GOOGLE_FONTS=true
