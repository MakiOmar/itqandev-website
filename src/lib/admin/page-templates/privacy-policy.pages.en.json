                                            "id": "kit_privacy_permissions",
                                            "kind": "kit",
                                            "type": "image_text",
                                            "enabled": true,
                                            "settings": {
                                                "eyebrow": "3.3",
                                                "title": "Optional permissions and why we ask",
                                                "body": "<div class=\"overflow-x-auto\"><table><thead><tr><th>Permission</th><th>When</th><th>Purpose</th></tr></thead><tbody><tr><td>Internet</td><td>License activate/validate</td><td>Unlock the App</td></tr><tr><td>Contacts</td><td>Only if you tap “Contacts” when adding a student</td><td>Pick a phone number faster (you choose which contact)</td></tr><tr><td>Camera / photos</td><td>Only if you set a tutor profile photo</td><td>Display your profile image on-device</td></tr><tr><td>Notifications</td><td>If you enable reminders</td><td>Session / reminder alerts</td></tr><tr><td>Biometric / device lock</td><td>If you enable App Lock</td><td>Unlock the App with fingerprint/Face/PIN (processed by the device OS; we do not receive biometric templates)</td></tr></tbody></table></div><p>You can deny optional permissions; core offline features still work, except the related feature.</p>",
                                                "image": null,
                                                "image_position": "right",
                                                "button_label": "",
                                                "button_url": "",
                                                "translations": {
                                                    "ar": {
                                                        "eyebrow": "3.3",
                                                        "title": "الأذونات الاختيارية",
                                                        "body": "<div class=\"overflow-x-auto\"><table><thead><tr><th>الإذن</th><th>متى</th><th>الغرض</th></tr></thead><tbody><tr><td>الإنترنت</td><td>تفعيل/التحقق من الترخيص</td><td>فتح التطبيق</td></tr><tr><td>جهات الاتصال</td><td>عند اختيار رقم من جهات الاتصال</td><td>إدخال أسرع لأرقام الطلاب</td></tr><tr><td>الكاميرا / الصور</td><td>عند اختيار صورة الملف الشخصي</td><td>عرض صورتك محلياً</td></tr><tr><td>الإشعارات</td><td>عند تفعيل التذكيرات</td><td>تنبيهات الحصص</td></tr><tr><td>القياسات الحيوية / قفل الجهاز</td><td>عند تفعيل قفل التطبيق</td><td>فتح التطبيق ببصمة/وجه/رمز (يعالجها نظام الجهاز؛ لا نستلم قوالب البصمة)</td></tr></tbody></table></div><p>يمكنك رفض الأذونات الاختيارية؛ تبقى الميزات الأساسية دون اتصال متاحة باستثناء الميزة المرتبطة بالإذن.</p>"
                                                    }
