                                    "blocks": [
                                        {
                                            "id": "kit_privacy_children_choices",
                                            "kind": "kit",
                                            "type": "image_text",
                                            "enabled": true,
                                            "settings": {
                                                "eyebrow": "8–10",
                                                "title": "Children, your choices, and international processing",
                                                "body": "<h3>Children</h3><p>The App is intended for <strong>adults</strong> (teachers / tutors). It is not directed at children. Student records you enter are under your responsibility as the tutor.</p><h3>Your choices</h3><ul><li>Edit or delete students and records inside the App</li><li>Export or delete backups you created</li><li>Revoke Contacts / Camera / Notification permissions in system settings</li><li>Deactivate the license from the App’s license screen (where available)</li><li>Uninstall the App to remove local data (backups you exported remain where you saved them)</li></ul><h3>International processing</h3><p>License validation may be processed on servers operated for ULSP (see domain above). By activating a license you understand that limited license metadata leaves your device.</p>",
                                                "image": null,
                                                "image_position": "right",
                                                "button_label": "",
                                                "button_url": "",
                                                "translations": {
                                                    "ar": {
                                                        "eyebrow": "8–9",
                                                        "title": "الأطفال وخياراتك",
                                                        "body": "<h3>الأطفال</h3><p>التطبيق موجّه <strong>للبالغين</strong> (المدرسين). مسؤولية بيانات الطلاب التي تُدخلها تقع عليك كمدرّس.</p><h3>خياراتك</h3><p>تعديل أو حذف السجلات داخل التطبيق، تصدير/حذف النسخ الاحتياطية، إلغاء الأذونات من إعدادات النظام، إلغاء تفعيل الترخيص من شاشة الترخيص إن وُجدت، أو إلغاء تثبيت التطبيق.</p>"
                                                    }
                                                }
                                            }
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
