# --- Env split (this repo) ---
# Dev:  copy to `.env` (gitignored). `npm run dev` uses --mode ssr → loads `.env`.
# Build: `.env.production` is committed and used by `npm run build` (mode=production).
#         Production keys override the same names from `.env` if both are present.
# Hostinger panel VITE_* vars still override at deploy build time when set.

# --- Laravel API (required for marketing API + dashboard auth) ---
# Dev (recommended): relative /api + Vite proxy so SSR and browser share the same origin.
# VITE_API_PROXY_TARGET = origin where GET /api/public/ping works (no /api suffix).
#   Root vhost:  http://itqandev.com          (ping at http://itqandev.com/api/public/ping)
#   Subfolder:   http://itqandev.com/credocode/backend/public
VITE_API_BASE_URL=/api
# Vite proxy target (no /api suffix). Browser /api → proxy → Laravel.
# If WAMP :80 hangs from Vite/Node, use artisan serve instead:
VITE_API_PROXY_TARGET=http://127.0.0.1:8000
VITE_SSR_API_BASE_URL=http://127.0.0.1:8000/api
VITE_PUBLIC_SITE_URL=http://127.0.0.1:5173
# WAMP vhost on port 80:
# VITE_API_PROXY_TARGET=http://itqandev.com
# Node SSR in dev calls VITE_API_PROXY_TARGET + /api directly (not :5173). Optional override:
# VITE_SSR_API_BASE_URL=http://itqandev.com/api
# When Vite picks another port (e.g. 5174), set this so Node SSR uses the same origin:
# VITE_DEV_SERVER_ORIGIN=http://127.0.0.1:5174
# Browser API diagnostics (timing + server_ms): http://127.0.0.1:5173/en/api-check
# VITE_API_PROXY_TARGET is used for /storage media rewrite and dev SSR API calls.
# When API and site are on different hosts, set the public site origin for canonical URLs, OG, and sitemap:
# VITE_PUBLIC_SITE_URL=https://itq.example.com

# Production live URLs live in `.env.production` (do not put them only in `.env`).
# Example (also on Hostinger before build):
# VITE_API_BASE_URL=https://api.gamesspoteg.com/api
# VITE_API_PROXY_TARGET=https://api.gamesspoteg.com
# VITE_SSR_API_BASE_URL=https://api.gamesspoteg.com/api
# VITE_PUBLIC_SITE_URL=https://itq.gamesspoteg.com

# Optional explicit marketing API (defaults to VITE_API_BASE_URL)
# VITE_MARKETING_API_URL=/api

# --- Auth (see website/docs/CONFIGURATION.md) ---
# Production: always use Laravel (mock is for offline UI demos only).
VITE_AUTH_PROVIDER=laravel
VITE_LARAVEL_SANCTUM=true
VITE_API_TIMEOUT=8000
VITE_PUBLIC_LOGIN=/admin/login
# VITE_AUTH_PROVIDER=laravel
# VITE_LARAVEL_SANCTUM=true
# VITE_PUBLIC_LOGIN=/admin/login

# --- Marketing content (local JSON vs Laravel public API) ---
# VITE_MARKETING_CONTENT_SOURCE=api

# Skip Google Fonts on public marketing pages only (admin/dashboard still loads Inter/Cairo).
VITE_DISABLE_GOOGLE_FONTS=true
