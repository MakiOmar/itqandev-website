# Local `npm run preview` (Vite mode=preview → http://localhost:4173).
# Keeps production live URLs in `.env.production` for deploy builds.
# Browser: same-origin /api via Vite preview proxy → VITE_API_PROXY_TARGET.
# Node SSR: VITE_SSR_API_BASE_URL (must not call :4173 or the request can stall).

VITE_PUBLIC_SITE_URL=http://127.0.0.1:4173
VITE_API_BASE_URL=/api
VITE_API_PROXY_TARGET=http://127.0.0.1:8000
VITE_SSR_API_BASE_URL=http://127.0.0.1:8000/api
VITE_LARAVEL_SANCTUM=true
VITE_AUTH_PROVIDER=laravel
VITE_API_TIMEOUT=8000
VITE_PUBLIC_LOGIN=/admin/login
